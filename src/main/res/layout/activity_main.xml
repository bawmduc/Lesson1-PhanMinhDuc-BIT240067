<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Hàng 1: Ô 1 và 2 (Tỷ lệ 1:1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="#1A73E8"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="#EA4335"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng 2: Ô 3, 4 và 5 (Tỷ lệ 1:1:2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="#FCC934"
            android:gravity="center"
            android:text="3"
            android:textColor="#000000"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="#34A853"
            android:gravity="center"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:layout_margin="4dp"
            android:background="#8E24AA"
            android:gravity="center"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hàng 3: Ô 6 (Trải hết chiều ngang) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:background="#F67C00"
            android:gravity="center"
            android:text="6"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khoảng trống phía dưới để đẩy Text "Họ và tên" xuống đáy -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- Dòng text Họ và tên - MSSV -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Phan Minh Đức - BIT240067"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>